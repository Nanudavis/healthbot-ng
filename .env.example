# Copy to .env and fill in the values needed for your environment.
# Never commit .env or real credentials.

# ── Application and database ───────────────────────────────────
DATABASE_URL=sqlite:///data/healthbot.db
CONSOLE_AUTH_REQUIRED=true
ADMIN_TOKEN=
SESSION_STORE=memory
SESSION_TTL_SECONDS=3600
STORE_TRANSCRIPTS=false
SEED_SAMPLE_FACILITIES=false

# ── WhatsApp / Twilio ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
PUBLIC_BASE_URL=
WHATSAPP_ASYNC_OUTBOUND=false
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_POLL_SECONDS=1
OUTBOUND_RETRY_BASE_SECONDS=5

# ── LLM conversation and triage ────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Leave blank for OpenAI, or use an OpenAI-compatible /v1 endpoint.
OPENAI_BASE_URL=
# Optional JSON object, for example {"reasoning_effort":"high"}.
OPENAI_EXTRA_PARAMS=
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=3
LLM_MAX_BACKOFF_SECONDS=20

# Optional keys used only by the model-comparison harness.
GROQ_API_KEY=
AGENTROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY_DIRECT=

# ── Embeddings and RAG ─────────────────────────────────────────
# Supported providers: openai, local, hf.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_API_TOKEN=
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PINECONE_API_KEY=
PINECONE_INDEX=healthbot-protocols
PROTOCOLS_DIR=data/protocols
LOCAL_INDEX_PATH=data/index/protocols.local.json

# ── Surveillance alert thresholds ──────────────────────────────
ALERT_WINDOW_DAYS=14
ALERT_MIN_COUNT=5
ALERT_MULTIPLIER=2.0
